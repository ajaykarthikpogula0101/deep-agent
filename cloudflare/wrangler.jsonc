{
  // The assistant runs as a Cloudflare Container (the repo's own Dockerfile) behind this Worker.
  "name": "deependhq-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Assistant",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      // The app keeps its rate limiter and scheduler in memory: exactly one instance, never two.
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "class_name": "Assistant", "name": "ASSISTANT" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Assistant"] }],
  // Database snapshots from the container's embedded Postgres (docker/backup.py) land here.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "deependhq-assistant-backups" }],
  "routes": [{ "pattern": "assistant.deependhq.com", "custom_domain": true }],
  // Wakes the container if Cloudflare recycled its host, so the in-process scheduler (recrawl, reminders) keeps running.
  "triggers": { "crons": ["*/2 * * * *"] }
}
