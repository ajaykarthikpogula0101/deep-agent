# ---- Chat model: any OpenAI-compatible endpoint ----
# OpenRouter:        LLM_BASE_URL=https://openrouter.ai/api/v1       CHAT_MODEL=openai/gpt-4.1-mini  (any tool-capable model)
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1     CHAT_MODEL=openai/gpt-oss-120b
# OpenAI:            LLM_BASE_URL=                                    CHAT_MODEL=gpt-4.1-mini
# Check what your key can use: curl -H "Authorization: Bearer $LLM_API_KEY" <base url>/models
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4.1-mini

# ---- Embeddings: local Hugging Face model via fastembed (free, no key, CPU) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_PATH=/models           # optional: where the ~130 MB model is cached

# ---- Postgres + pgvector ----
DATABASE_URL=postgresql://assistant:assistant@db:5432/assistant   # running outside Docker on Windows: use 127.0.0.1, not localhost

# ---- Knowledge base ----
SITE_BASE_URL=https://deependhq.com
CRAWL_USER_AGENT=deependhq-assistant/0.1 (+https://deependhq.com; answers questions about this site)
RECRAWL_CRON=30 2 * * *          # 02:30 IST daily, after the site's ~01:00 IST nightly rebuild
RECRAWL_TZ=Asia/Kolkata
RETRIEVAL_MIN_SCORE=0.60         # coarse gate on the bge-small scale (calibrated 2026-10-05); the prompt handles the rest
RETRIEVAL_TOP_K=6

# ---- Security / cost ----
ALLOWED_ORIGINS=https://deependhq.com,https://www.deependhq.com
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200
DAILY_SPEND_CAP_USD=5.00
MAX_MESSAGE_CHARS=1500

# ---- Zoom Scheduler (official API, Server-to-Server OAuth app) ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The host's public booking page. All active schedules on it are offered (today: discovery-call 15 min,
# lakeb2b-product-walkthrough-use-case-demo 30 min, gtm-strategy-session-data-ai-revenue-acceleration 45 min).
# The list is fetched live, so adding or renaming a schedule in Zoom needs no code change.
ZOOM_BOOKING_USER=sreedeep
ZOOM_BOOKING_BASE=https://scheduler.zoom.us/sreedeep
HOST_TIMEZONE=Asia/Kolkata
# Query parameter names for GET /scheduler/schedules/{id}/available_times.
# TODO(verify): confirm against the live reference at developers.zoom.us/docs/api/scheduler/
ZOOM_AVAIL_PARAM_FROM=from
ZOOM_AVAIL_PARAM_TO=to
ZOOM_AVAIL_PARAM_TZ=time_zone
ZOOM_ENABLE_API_BOOKING=false   # true once POST /scheduler/attendee is confirmed working on this account

# ---- Host brief email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=assistant@deependhq.com
HOST_EMAIL=deep@championsmail.com

# ---- Session origin tracking (docs/TRACKING.md) ----
ADMIN_TOKEN=change-me-long-random      # protects /admin (sessions dashboard, recrawl, purge); empty disables them
TRUST_PROXY=true                       # honour CF-Connecting-IP / X-Forwarded-For (keep true behind Cloudflare/nginx)
TRACKING_ENABLED=true
GEOIP_PROVIDER=ipwho                   # ipwho | ipinfo | ipapi | none
GEOIP_TOKEN=                           # ipinfo only
TRACK_IP_MODE=full                     # full | masked (/24 and /48 only; EU-friendlier)
TRACK_RETENTION_DAYS=90                # IP + user agent nulled after this; geo/channel aggregate stays

# ---- In-app widget identity (docs/WIDGET.md) ----
WIDGET_SIGNING_SECRET=change-me-long-random   # shared with the host app's backend, which mints visitor tokens
CLERK_JWT_ISSUER_DOMAIN=                      # or verify Clerk session JWTs from this issuer
WIDGET_DEMO=false                             # /demo host page with a sample signed-in user

# ---- Composer media (docs/WIDGET.md) ----
PRIVACY_URL=https://deependhq.com/privacy    # footer link in the widget
UPLOAD_DIR=uploads                           # where attachments are stored (relative to the repo or absolute)
UPLOAD_MAX_MB=10
GIF_PROVIDER=tenor                           # tenor | giphy; empty key hides the GIF button
GIF_API_KEY=
STT_PROVIDER=browser                         # browser (Web Speech API) | openai (any /audio/transcriptions endpoint, e.g. Groq whisper)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
TTS_PROVIDER=browser                         # browser (SpeechSynthesis) | openai (/audio/speech)
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---- Automations (docs/AUTOMATIONS.md) ----
DIGEST_ENABLED=true                          # weekly digest email to HOST_EMAIL
DIGEST_CRON=0 9 * * 1                        # Monday 09:00 in HOST_TIMEZONE
NUDGE_ENABLED=true                           # one reminder to visitors whose Zoom hand-off is still unconfirmed
NUDGE_AFTER_HOURS=24
ENRICH_ENABLED=true                          # company from the visitor's email domain (homepage fetch, cached 30 days)
SUGGESTIONS_DAYS=30                          # window for the "most asked" quick replies
MULTILINGUAL=true                            # answer in the visitor's language (one short translation call for retrieval)
OUTREACH_ENABLED=true                        # proactive outreach rules: the greeting bubble follows console rules (docs/OUTREACH.md)

# ---- In-chat booking (docs/BOOKING.md) ----
ZOOM_HOST_USER_ID=                           # Deep's Zoom user id or email: POST /users/{id}/meetings fallback when the Scheduler API can't book
ZOOM_ENABLE_API_BOOKING=true                 # book through POST /scheduler/attendee when S2S credentials are set
PUBLIC_BASE_URL=https://assistant.deependhq.com   # used for the calendar / manage links in emails
BOOKING_DAYS_AHEAD=14                        # how far the in-chat picker looks
AVAILABILITY_CACHE_SECONDS=60
HOST_HOURS=                                  # e.g. 09:00-18:00 (HOST_TIMEZONE); empty = inferred from Zoom's open slots
BOOKING_MAX_ACTIVE_PER_EMAIL=2               # upcoming bookings one email address may hold
DEMO_USER_NAME=Ada Lovelace                  # the /demo signed-in user (WIDGET_DEMO=true only)
DEMO_USER_EMAIL=ada@lovelace.org
